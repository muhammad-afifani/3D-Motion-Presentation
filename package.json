{
  "name": "engine-turbine-emission-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Presentasi web 3D interaktif: siklus termodinamika, efisiensi, dan emisi penggerak migas",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:offline": "vite build --mode offline",
    "preview": "vite preview",
